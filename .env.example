# Generate real local secrets with pnpm env:init; never commit .env
POSTGRES_USER=sora
POSTGRES_DB=sora_dev
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_SECRET=
# AUTH_SECRET: random session secret, at least 32 characters; keep existing .env secret.
NEXTAUTH_URL=http://localhost:3000
# Discord redirect: http://localhost:3000/api/auth/callback/discord
# Keep the browser origin consistent with NEXTAUTH_URL.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# OAuth Client ID/Client Secret from Discord Developer Portal; not the bot token.
DISCORD_BOT_TOKEN=
DISCORD_SITE_URL=
# Public site linked by the bot (HTTPS in production).
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Explicit staff allowlists, Discord user IDs separated by commas. Empty = no staff.
ADMIN_DISCORD_IDS=
MODERATOR_DISCORD_IDS=
