{
  "name": "sora-rng-environment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "share:public": "node scripts/share-public.mjs",
    "share:stop": "node scripts/share-public.mjs --stop",
    "bot:dev": "tsx --env-file=.env bot/index.ts",
    "bot:check": "tsx bot/check.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx --env-file=.env scripts/check-db.ts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "assets:research": "node scripts/research-card-assets.mjs",
    "assets:prepare": "node scripts/card-assets.mjs --prepare",
    "assets:check": "node scripts/card-assets.mjs",
    "assets:test": "node scripts/test-card-images.mjs",
    "assets:local": "node scripts/prepare-local-card-assets.mjs",
    "test:integration": "tsx --env-file=.env scripts/test-game.ts",
    "test:auth": "tsx scripts/test-auth-integration.ts",
    "test:community": "tsx --env-file=.env scripts/test-community.ts",
    "test:arena": "tsx --env-file=.env scripts/test-arena.ts",
    "test:admin": "tsx --env-file=.env scripts/test-admin-integration.ts",
    "auth:check": "tsx scripts/check-auth-config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "env:init": "node scripts/init-env.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
